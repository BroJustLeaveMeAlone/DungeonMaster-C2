# DungeonMaster — environment template
# Copy to .env and fill in real values before running docker compose up

# Generate with: openssl rand -hex 32
DM_JWT_SECRET=

DM_POSTGRES_USER=dm
DM_POSTGRES_PASSWORD=

DM_REDIS_PASSWORD=

DM_MINIO_ACCESS_KEY=
DM_MINIO_SECRET_KEY=

# Public address agents/browsers use to reach MinIO (presigned URLs)
# In prod, set to your redirector or public IP
DM_MINIO_PUBLIC_ADDR=localhost:9000

# Required for AI report generation (ai/ service). Leave blank to disable.
ANTHROPIC_API_KEY=
